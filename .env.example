# Zerodha Kite (server only; never publish secrets or access tokens).
KITE_API_KEY=
KITE_API_SECRET=
# Configure the Kite app redirect URL as http://127.0.0.1:4174/api/kite/callback

# Obtain a StreamAllSymbols account with BOTH NSE and BSE enabled from Global Datafeeds.
# Use the secure endpoint supplied by the vendor. Never place credentials in dist/.
GFD_WS_URL=
GFD_API_KEY=
PORT=4174

# Zerodha daily instruments use the public endpoint; no credential is needed.
